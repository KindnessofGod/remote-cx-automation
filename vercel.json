{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sha=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\"; git cat-file -e \"$sha^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$sha\" HEAD -- api deploy src package.json package-lock.json vercel.json",
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --omit=dev --no-audit --no-fund",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api?__cx_path="
    },
    {
      "source": "/:cxpath*",
      "destination": "/api?__cx_path=:cxpath*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
