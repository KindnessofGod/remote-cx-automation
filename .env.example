# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Leaving any of these unset keeps the project on its safe defaults (mock Remote API,
# rule-based classifier, in-memory/file audit log) — exactly what `npm test` uses.

# --- Remote.com API -----------------------------------------------------------
# Sandbox gateway host (see developer.remote.com). Leave unset to keep using the
# local mock server (npm run mock) at http://localhost:4010.
REMOTE_BASE_URL=https://gateway.remote-sandbox.com
# Customer API token generated in Remote Sandbox: Company Settings -> Integrations
# & APIs -> Remote API -> Generate API Token. Sandbox tokens start with ra_test_.
REMOTE_API_TOKEN=ra_test_your_token_here

# --- OpenAI ---------------------------------------------------------------------
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Supabase (Postgres) ---------------------------------------------------------
# This IS your Postgres credential — there is no separate Postgres server or
# credential to provision. Supabase's project already runs Postgres; this is
# the connection string, from Supabase project settings -> Database ->
# Connection string (URI). Using the `postgres` role so writes bypass the
# audit_log table's RLS (no policies are defined on it, so any other role would
# be denied).
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Zendesk ----------------------------------------------------------------
# No MCP for Zendesk exists — this connects via Zendesk's REST API directly,
# the same way Remote is wired above. Leave unset to keep using the local mock
# (npm run zendesk-mock) at http://localhost:4014.
# Subdomain: the "xyz" in https://xyz.zendesk.com
ZENDESK_SUBDOMAIN=your_subdomain

# PREFERRED: OAuth client_credentials (Zendesk is phasing out API tokens —
# new-token creation may already be blocked on your account, see BUILD-LOG.md).
# Generate at: Admin Center -> Apps and integrations -> APIs -> OAuth clients
# -> Add OAuth client -> grant type: Client Credentials.
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=

# LEGACY fallback: API token (only if your account still allows creating one).
# Admin Center -> Apps and integrations -> APIs -> API configuration -> turn on
# "Allow API token access" -> Save -> API tokens -> Add API token.
# ZENDESK_EMAIL=agent@example.com
# ZENDESK_API_TOKEN=your_api_token_here

# The custom-field id on your verification-request ticket form that carries the
# Remote employment id (see src/zendesk/normalizeTicket.js) — find it in Admin
# Center -> Objects and rules -> Ticket fields, or via GET /api/v2/ticket_fields.
ZENDESK_EMPLOYMENT_ID_FIELD_ID=

# --- Slack (UC-06 urgent-cutoff alert) ------------------------------------
# Incoming-webhook URL for src/uc06/slackNotifier.js. Posts one message when
# an amendment is flagged "urgent_cutoff" (still inside the payroll cutoff
# window but <= 48h from it — see src/uc06/cutoffEngine.js). Leave unset to
# keep the notifier a true no-op: no network call is ever attempted, and the
# amendment decision itself is completely unaffected either way (background,
# best-effort — never throws, never blocks, never retried).
# Create one at: Slack -> Apps -> Incoming Webhooks -> Add New Webhook.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# ZAF SIDEBAR / REVIEW API  (zaf-app/, src/review/) — all optional
# ---------------------------------------------------------------------------
# The sidebar itself holds no credentials: it calls the review API, which holds
# them all. `npm run review-api` works with none of these set — it seeds real
# cases through the workflow into an in-memory store and serves those.

# Pin CORS to your Zendesk account instead of the "*" development default.
# CORS is not an authorization mechanism (every write is gated by
# src/review/reviewPolicy.js), but there is no reason to leave it open.
# ZAF_ALLOWED_ORIGIN=https://your_subdomain.zendesk.com

# Approver identity. NEITHER OF THESE IS NORMALLY NEEDED — the default is
# chosen from whether a durable store is attached, which is the thing that
# actually distinguishes a demo from a deployment here (`npm run uc06-api` is
# both, depending on configuration):
#
#   real Supabase pool  -> signed identity REQUIRED. The server reads a signed
#                          JWT from `Authorization: Bearer <token>` (what the
#                          sidebar sends) or X-ZAF-Token, verifies it against
#                          the key below, and uses ONLY the verified claim as
#                          the approver. X-ZAF-Approver is not read at all in
#                          this mode, so a valid signature can never be paired
#                          with a spoofed display name.
#   seeded in-memory    -> the sidebar's X-ZAF-Approver header is trusted, so a
#                          fresh clone can click approve with no setup.
#
# With signed identity required and no public key configured below, every
# state-changing call is refused (401 signed_identity_not_configured) rather
# than silently falling back to trusting the header. That refusal is
# deliberate: a service that downgrades its auth under misconfiguration has no
# auth, and a refused approval is recoverable in a minute while an approval
# attributed to an attacker-supplied string is not.
#
# Set either variable only to override that. Exact string "true"; nothing else
# counts. If you set both, the strict one wins.
# ZAF_REQUIRE_SIGNED_IDENTITY=true      # force strict, even for a seeded demo
# ZAF_ALLOW_UNSIGNED_IDENTITY=true      # accept the header posture deliberately,
                                        # even with a durable store attached

# ---------------------------------------------------------------------------
# THE ONE THAT ACTUALLY APPLIES TO zaf-app/: the HS256 shared secret.
# ---------------------------------------------------------------------------
# zaf-app/ is a CLIENT-SIDE ZAF app (a static bundle Zendesk hosts). It signs
# each approve/deny with ZAF's own JWT mechanism — client.request()'s `jwt`
# block — and ZAF signs those HS256 only. Set the SAME value in two places:
#   1. here, as ZAF_SHARED_SECRET, on every API that verifies approvals;
#   2. in the installed app's SECURE setting `cxSharedSecret` (Zendesk holds it
#      server-side; it never reaches the browser or the downloadable bundle).
# Any long random string works — it is a secret you choose, not something
# fetched from Zendesk. Rotate by changing both sides.
#   openssl rand -base64 48
# ZAF_SHARED_SECRET=

# ---------------------------------------------------------------------------
# The RS256 pair below is a DIFFERENT MECHANISM for a DIFFERENT app type —
# a server-side app, where Zendesk signs a request it makes to us. This repo
# ships no such app. Setting either of these ALONGSIDE ZAF_SHARED_SECRET is
# refused outright (no verifier is built, so every approve/deny is 401'd)
# rather than silently resolved, because the two belong to different apps and
# picking one would leave the operator believing the other is in force.
# ---------------------------------------------------------------------------

# The ZAF app's own RS256 public key, used to verify a server-side app's signed
# request. Per Zendesk's documented mechanism (see the header comment in
# src/review/zafAuth.js for both mechanisms and their sources), fetch it once
# via:
#   GET https://<subdomain>.zendesk.com/api/v2/apps/<app_id>/public_key.pem
# and paste the PEM here. Multi-line values work if double-quoted (dotenv
# expands \n itself); an unquoted/single-quoted value with literal \n
# sequences is also accepted — src/review/cli.js normalizes either.
# ZAF_APP_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMII...\n-----END PUBLIC KEY-----\n"

# Alternative to pasting the PEM above: set the installed app's numeric id
# here and cli.js fetches the key live at startup, via Basic auth using the
# LEGACY ZENDESK_EMAIL/ZENDESK_API_TOKEN pair above (the OAuth
# client_credentials path has no email/token pair to send as Basic auth, so
# this only works on accounts still using the legacy token). Ignored if
# ZAF_APP_PUBLIC_KEY_PEM is set — the static PEM always takes priority, since
# it adds no network call (and no possible startup failure) to booting this
# process.
# ZAF_APP_ID=123456

# Optional extra checks once a token is being verified — only enforced when set.
# ZAF_JWT_ISSUER=zendesk-app
# ZAF_JWT_AUDIENCE=review-api

# ---------------------------------------------------------------------------
# The request portal (src/portal/, `npm run portal`, and /portal on the
# deployment)
# ---------------------------------------------------------------------------
# One shared key, sent by the page as the header `x-portal-key`. You choose the
# value; nothing issues it (`openssl rand -hex 24` is fine).
#
# WHEN IT IS REQUIRED — the rule is in src/portal/access.js and is copied from
# the nine APIs' readPosture():
#     required = (a durable store is attached) OR (the deployment is public)
# ORed, so the platform check can add the requirement but never remove one. A
# fresh clone with no SUPABASE_DB_URL needs nothing here and `npm run portal`
# just runs. Set SUPABASE_DB_URL and the portal starts refusing every API call
# until this is set too (or until you run `npm run portal -- --seeded`), and it
# says so at startup — a portal submission runs the real gates and writes an
# audit row, so it should not be anonymous once those rows are durable.
#
# It proves possession of a secret and NOTHING else — not who is asking. It is
# deliberately weaker than the ZAF-signed identity above, because the portal is
# not inside Zendesk and no ZAF token exists for it.
# PORTAL_ACCESS_KEY=

# Relaxes the DURABILITY half of the rule for a local demo pointed at Supabase.
# It cannot open a publicly reachable deployment — that half is ORed on top.
# Exact string "true" only.
# PORTAL_ALLOW_OPEN_ACCESS=true

# Forces the key on even with nothing durable attached. Exact string "true".
# PORTAL_REQUIRE_ACCESS_KEY=true

# --- n8n ------------------------------------------------------------------------
# REQUIRED by `npm run verify-deployed` (scripts/verify-deployed-nodes.mjs),
# which compares every repo-backed Code node against the DEPLOYED graph body.
# These were missing from this file until 2026-08-21 even though the script has
# always required them — with either unset the script exits 2, and the contract
# is explicit that exit 2 is NOT a pass. A skipped check must never look like a
# passing one, so it fails loudly rather than silently degrading.
#
# Base URL of the n8n instance. NO trailing slash and NO trailing dot: a dot is
# a legal DNS root label, so the host still resolves but no longer matches the
# TLS certificate, and the failure surfaces as a bare "fetch failed" with
# nothing pointing at the URL. The script warns and corrects rather than fixing
# it silently, but it is worth setting correctly at the source.
N8N_BASE_URL=https://your-instance.app.n8n.cloud
# n8n API key: Settings -> n8n API -> Create an API key.
N8N_API_KEY=
